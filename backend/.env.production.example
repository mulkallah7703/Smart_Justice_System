# =============================================================================
# Backend — PRODUCTION EXAMPLE (never commit real secrets)
# Copy to backend/.env.production for local prod-like runs only.
# Compose deployments should prefer infra/docker/.env.production.
# =============================================================================

NODE_ENV=production
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=https://app.example.com

DATABASE_URL=postgresql://sjs:CHANGE_ME@postgres:5432/sjs_prod?schema=public
REDIS_URL=redis://:CHANGE_ME@redis:6379

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET=CHANGE_ME
S3_BUCKET=sjs-documents

JWT_ACCESS_SECRET=CHANGE_ME_long_random_jwt_secret
JWT_ACCESS_EXPIRES_IN=15m

# Nafath = DEFERRED — not required for readiness
NAFATH_MODE=inactive

# Payment = DEFERRED — not required for readiness
PAYMENT_PROVIDER=deferred
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_unused_while_deferred

# Real AI only — mock modes are refused when NODE_ENV=production
AI_PROVIDER_MODE=openai
AI_LLM_MODE=openai
AI_EMBEDDING_MODE=openai
AI_VECTOR_STORE_MODE=qdrant
AI_TEXT_EXTRACTOR_MODE=pdf
AI_OCR_MODE=local
AI_OCR_LANG_PATH=.ocr-data
AI_OCR_TESSDATA=fast
AI_ADVISOR_EXPERIMENTAL=true
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_QDRANT_URL=
AI_QDRANT_API_KEY=
AI_QDRANT_COLLECTION=legal_chunks_v1
