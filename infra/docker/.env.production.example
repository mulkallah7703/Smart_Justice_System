# Copy to infra/docker/.env.production and fill secrets.
# NEVER commit .env.production.
#
# Used by: docker compose -f infra/docker/docker-compose.production.yml --env-file infra/docker/.env.production

IMAGE_TAG=local
HTTP_PORT=80
HTTPS_PORT=443

# Public URL baked into the frontend at build time (must be HTTPS in real prod).
VITE_API_BASE_URL=https://app.example.com/api/v1
VITE_AI_ADVISOR_EXPERIMENTAL=true

# Host paths for TLS material (see docs/HTTPS.md). Do not commit keys.
TLS_CERTS_HOST_PATH=./certs
CERTBOT_WWW_PATH=./certbot-www

# PostgreSQL (internal)
POSTGRES_USER=sjs
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password
POSTGRES_DB=sjs_prod

# Redis (internal) — password required in production compose
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# MinIO (internal) — root for console/init only; app uses least-privilege keys
MINIO_ROOT_USER=sjs_minio_root
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_root_password
# Application access key (create via mc admin user / console — NOT the root user)
S3_ACCESS_KEY=sjs_app
S3_SECRET=CHANGE_ME_strong_minio_app_password
S3_BUCKET=sjs-documents

# JWT / CORS (passed through env_file into api/worker)
JWT_ACCESS_SECRET=CHANGE_ME_long_random_jwt_secret
JWT_ACCESS_EXPIRES_IN=15m
CORS_ORIGINS=https://app.example.com
LOG_LEVEL=info

# AI — real providers only (no mock)
AI_PROVIDER_MODE=openai
AI_LLM_MODE=openai
AI_EMBEDDING_MODE=openai
AI_VECTOR_STORE_MODE=qdrant
AI_TEXT_EXTRACTOR_MODE=pdf
AI_OCR_MODE=local
AI_OCR_TESSDATA=fast
AI_ADVISOR_EXPERIMENTAL=true
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_QDRANT_URL=
AI_QDRANT_API_KEY=
AI_QDRANT_COLLECTION=legal_chunks_v1

# Deferred integrations — required values; not readiness blockers
NAFATH_MODE=inactive
PAYMENT_PROVIDER=deferred
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_payment_webhook_secret_unused_while_deferred
