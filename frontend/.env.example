# Frontend environment EXAMPLE
# Copy to .env / .env.development / .env.production as needed.
# Never commit secrets. Never put OPENAI_API_KEY here.

# real (default) | mock (development/test ONLY — forbidden in production builds)
VITE_API_MODE=real

# Required for real mode (and always required for production builds)
VITE_API_BASE_URL=http://localhost:3000/api/v1
