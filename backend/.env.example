# =============================================================================
# Smart Judicial System — backend environment EXAMPLE (shared reference)
# Copy to .env / .env.development / .env.test or use .env.production.example.
# Never commit real secrets.
# =============================================================================

# development | test | staging | production
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgresql://sjs:sjs_dev_only_change_me@localhost:5432/sjs_dev?schema=public
# Prisma Migrate reads DIRECT_URL. Locally it matches DATABASE_URL.
# Neon: pooled host (contains -pooler) in DATABASE_URL, direct host in DIRECT_URL.
DIRECT_URL=postgresql://sjs:sjs_dev_only_change_me@localhost:5432/sjs_dev?schema=public
# redis:// locally. Upstash uses rediss:// (TLS). BullMQ sets maxRetriesPerRequest=null.
REDIS_URL=redis://localhost:6379
# false when a separate `node dist/worker.js` process is running (Compose).
# Set true on the single Render web service so the API process consumes the queue.
RUN_WORKER_IN_PROCESS=false

# Object storage (S3_* or MINIO_* aliases). Required in production.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=sjs_minio_dev
S3_SECRET=sjs_minio_dev_secret_local_only
S3_BUCKET=sjs-documents-dev
# Cloudflare R2: S3_REGION=auto and S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# The client always uses path-style requests (MinIO and R2).
# S3_REGION=us-east-1
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=sjs_minio_dev
# MINIO_SECRET_KEY=sjs_minio_dev_secret_local_only
# MINIO_BUCKET=sjs-documents-dev

# JWT (JWT_SECRET alias accepted)
JWT_ACCESS_SECRET=local-dev-jwt-access-secret-do-not-reuse
JWT_ACCESS_EXPIRES_IN=15m

# -----------------------------------------------------------------------------
# Nafath = DEFERRED (not required for production operation)
# production default: inactive | development default: mock
# -----------------------------------------------------------------------------
NAFATH_MODE=mock
MOCK_NAFATH_CODE=72

# -----------------------------------------------------------------------------
# Payment = DEFERRED (not required for production operation)
# production default: deferred | development default: mock
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=local-dev-payment-webhook-secret-do-not-reuse

# -----------------------------------------------------------------------------
# AI — development may use mock; production MUST use real providers (no fallback)
# -----------------------------------------------------------------------------
AI_PROVIDER_MODE=mock
AI_TEXT_EXTRACTOR_MODE=mock
AI_OCR_MODE=mock
AI_EMBEDDING_MODE=mock
AI_VECTOR_STORE_MODE=mock
AI_LLM_MODE=mock

# Chunking (defaults: max 2000, overlap 0)
# AI_CHUNK_MAX_CHARS=2000
# AI_CHUNK_OVERLAP=200

# Production / real AI (uncomment and set secrets — never commit):
# AI_PROVIDER_MODE=openai
# AI_LLM_MODE=openai
# AI_EMBEDDING_MODE=openai
# AI_VECTOR_STORE_MODE=qdrant
# AI_TEXT_EXTRACTOR_MODE=pdf
# AI_OCR_MODE=local
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# AI_QDRANT_URL=http://127.0.0.1:6333
# QDRANT_URL=http://127.0.0.1:6333
# AI_QDRANT_COLLECTION=legal_chunks_v1
# AI_OCR_LANG_PATH=.ocr-data
# AI_OCR_TESSDATA=fast
# AI_ADVISOR_EXPERIMENTAL=true

AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SEC=60
