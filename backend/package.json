{
  "name": "judicial-system-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Smart Judicial System — NestJS modular monolith (foundation)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "worker": "nest start --entryFile worker",
    "worker:dev": "nest start --watch --entryFile worker",
    "worker:prod": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "infra:up": "docker compose -f ../infra/docker/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f ../infra/docker/docker-compose.dev.yml down",
    "ocr:langdata": "powershell -ExecutionPolicy Bypass -File ./scripts/fetch-ocr-lang-data.ps1",
    "test": "jest --config ./test/jest-unit.json",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:live": "jest --config ./test/jest-live.json --runInBand"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@napi-rs/canvas": "0.1.65",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.58.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "nestjs-pino": "^4.1.0",
    "openai": "^6.49.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfjs-dist": "3.11.174",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "tar": "7.5.22"
  }
}
