# PJSR — Hostinger co-tenancy environment EXAMPLE
# Copy to: infra/docker/.env.hostinger
#   cp infra/docker/.env.hostinger.example infra/docker/.env.hostinger
#   chmod 600 infra/docker/.env.hostinger
# NEVER commit .env.hostinger. Never reuse CHANGE_ME placeholders.
#
# Used by (always pass --env-file; do not rely on a committed env file):
#   docker compose -p pjsr -f infra/docker/docker-compose.hostinger.yml \
#     --env-file infra/docker/.env.hostinger ...
#
# The Compose file also accepts an optional on-disk env_file named .env.hostinger
# next to the compose file (required: false). Prefer the CLI --env-file flag.
#
# Private SSH-tunnel testing (no public HTTP, no domain required):
#   ssh -L 8083:127.0.0.1:8083 root@76.13.40.84
#   open http://localhost:8083

IMAGE_TAG=hostinger-local

# Frontend build-time API base — MUST match the browser origin through the tunnel.
# Browser talks to localhost:8083; the private edge proxies /api/ to the API container.
VITE_API_BASE_URL=http://localhost:8083/api/v1
VITE_AI_ADVISOR_EXPERIMENTAL=true

# Exact CORS origin for the tunneled SPA (no trailing slash, no *)
CORS_ORIGINS=http://localhost:8083

# PostgreSQL (internal only — never published)
POSTGRES_USER=pjsr
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password
POSTGRES_DB=pjsr_prod

# Redis (internal only — password required)
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# MinIO / Silo (internal only)
MINIO_ROOT_USER=pjsr_minio_root
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_root_password
S3_ACCESS_KEY=pjsr_app
S3_SECRET=CHANGE_ME_strong_minio_app_password
S3_BUCKET=pjsr-documents

# JWT
JWT_ACCESS_SECRET=CHANGE_ME_long_random_jwt_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
LOG_LEVEL=info

# AI — real providers only (production refuses mocks)
AI_PROVIDER_MODE=openai
AI_LLM_MODE=openai
AI_EMBEDDING_MODE=openai
AI_VECTOR_STORE_MODE=qdrant
AI_TEXT_EXTRACTOR_MODE=pdf
AI_OCR_MODE=local
AI_OCR_TESSDATA=fast
AI_ADVISOR_EXPERIMENTAL=true
# Co-tenancy: worker mem_limit is 768m. Keep concurrency at 1 so OCR
# (tesseract.js + page raster at AI_OCR_DPI, default 300) does not OOM.
# Do not raise these until a staged OCR validation on the VPS succeeds.
AI_WORKER_CONCURRENCY=1
AI_OCR_CONCURRENCY=1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_QDRANT_URL=
AI_QDRANT_API_KEY=
AI_QDRANT_COLLECTION=legal_chunks_v1

# Deferred integrations
NAFATH_MODE=inactive
PAYMENT_PROVIDER=deferred
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_payment_webhook_secret_unused_while_deferred
