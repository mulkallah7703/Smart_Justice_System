# Frontend production build example — never commit real secrets.
# Vite only embeds VITE_* at build time.

VITE_API_MODE=real
# Same-origin Docker/Nginx build. Free-tier Vercel uses the Render URL instead:
# VITE_API_URL=https://<service>.onrender.com/api/v1
VITE_API_BASE_URL=https://app.example.com/api/v1
# VITE_API_URL is accepted when VITE_API_BASE_URL is empty.
VITE_AI_ADVISOR_EXPERIMENTAL=true
